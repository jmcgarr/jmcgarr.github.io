.gradle/
build/
.DS_Store
*.ipr
*.iml
*.iws
.gradletasknamecache
.idea/
.vscode/
output/

# Native libraries JRuby/jffi may extract during a bake (should land in build/tmp/jffi)
jffi*.dylib
jffi*.so
jffi*.dll

# Heap dumps the Gradle daemon writes when it runs out of memory (T099)
*.hprof

# Python bytecode from running scripts/*.py locally (for example tag-redirects.py)
__pycache__/

# Generated by scripts/to-markdown/render.sh (compiled probe and a machine-specific jar list), and local Python venvs
scripts/to-markdown/classes/
scripts/to-markdown/flexmark.classpath
.venv/
